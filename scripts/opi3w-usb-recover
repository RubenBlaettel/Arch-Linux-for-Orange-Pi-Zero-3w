#!/bin/bash
# Setzt den USB-Controller am USB-C-Anschluss zurueck, wenn der xHCI-Teil haengen bleibt.
# Ohne das fallen Maus, Tastatur und Monitor-Hub bis zum naechsten Neustart aus.
# Das Zuruecksetzen laesst Bild und Ton ueber DisplayPort unberuehrt.
# Kein automatischer Neustart: Nach diesem Zuruecksetzen blieb er dreimal von dreimal am Ende haengen,
# und nur ein Stromtrennen half. Einen fehlenden Monitor-Hub holt opi3w-usbc-hub zurueck.
P=6a00000.xhci2-controller
D=/sys/bus/platform/drivers/dwc3
SEEN=/run/opi3w-usb-recover.seen

devices() { ls /sys/bus/usb/devices | grep -cE '^[0-9]+-[1-9]'; }

n=0
done_lines=$(cat "$SEEN" 2>/dev/null || echo 0)
journalctl -k -b -f -n all -o cat --grep='HC died' | while read -r _; do
	n=$((n + 1))
	[ "$n" -le "$done_lines" ] && continue
	echo "$n" > "$SEEN"
	echo "xHCI ausgefallen, setze $P zurueck"
	sleep 1
	echo "$P" > "$D/unbind"
	sleep 2
	echo "$P" > "$D/bind"
	# opi3w-usbc-hub holt einen fehlenden Monitor-Hub erst nach gut 60 s zurueck.
	for _ in $(seq 1 90); do [ "$(devices)" -gt 0 ] && break; sleep 1; done
	if [ "$(devices)" -gt 0 ]; then
		echo "USB-Geraete wieder da"
	else
		echo "USB-Geraete fehlen weiter"
	fi
done
